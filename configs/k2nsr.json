{
  "metadata": {
    "author": "HongyiFang",
    "date": "2025-12-11"
  },
  "model": {
    "reconstructor": {
      "scales": [
        {
          "patch_size": 1,
          "width": 384,
          "layers": 4,
          "heads": 8
        },
        {
          "patch_size": 2,
          "width": 448,
          "layers": 6,
          "heads": 8
        },
        {
          "patch_size": 3,
          "width": 768,
          "layers": 7,
          "heads": 8
        },
        {
          "patch_size": 4,
          "width": 864,
          "layers": 8,
          "heads": 8
        },
        {
          "patch_size": 6,
          "width": 1728,
          "layers": 9,
          "heads": 16
        }
      ],
      "channels": 32,
      "latent_size": 32,
      "feature_channels": [
        128,
        256
      ],
      "mlp_ratio": 4.0,
      "dropout": 0.1,
      "input_residual_init": 0.1,
      "feature_residual_init": 0.1,
      "residual_per_scale": true
